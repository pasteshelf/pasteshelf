<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Export method: app-store, ad-hoc, enterprise, development, developer-id -->
	<key>method</key>
	<string>developer-id</string>

	<!-- Team ID - Replace with actual Apple Developer Team ID when available -->
	<key>teamID</key>
	<string>TEAM_ID_PLACEHOLDER</string>

	<!-- Signing certificate name -->
	<key>signingCertificate</key>
	<string>Developer ID Application</string>

	<!-- Signing style: automatic or manual -->
	<key>signingStyle</key>
	<string>automatic</string>

	<!-- Destination: export (for local) or upload (for App Store Connect) -->
	<key>destination</key>
	<string>export</string>

	<!-- Strip Swift symbols for smaller binary size -->
	<key>stripSwiftSymbols</key>
	<true/>

	<!-- Upload symbols for crash reporting (App Store only) -->
	<key>uploadSymbols</key>
	<true/>

	<!-- Compile bitcode (not applicable for macOS, but included for completeness) -->
	<key>compileBitcode</key>
	<false/>

	<!-- Manage app version and build number automatically (App Store Connect) -->
	<key>manageAppVersionAndBuildNumber</key>
	<false/>

	<!-- Generate App Store Information property list -->
	<key>generateAppStoreInformation</key>
	<false/>

	<!-- Provisioning profiles - Optional, Xcode can determine automatically -->
	<!--
	<key>provisioningProfiles</key>
	<dict>
		<key>com.pasteshelf.PasteShelf</key>
		<string>PasteShelf Developer ID</string>
	</dict>
	-->

</dict>
</plist>
