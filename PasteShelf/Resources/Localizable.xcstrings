    "Enable discovery to auto-populate authorization, token, and JWKS endpoints from the issuer's well-known document." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktivieren Sie Discovery, um Authorization-, Token- und JWKS-Endpunkte automatisch aus dem Well-Known-Dokument des Anbieters zu laden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Active el descubrimiento para rellenar automáticamente los endpoints de autorización, token y JWKS desde el documento well-known del emisor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activez la découverte pour remplir automatiquement les endpoints d'autorisation, de jeton et JWKS depuis le document well-known de l'émetteur."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "発行者の well-known 文書から認可、トークン、JWKS エンドポイントを自動入力するには、ディスカバリを有効にしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "발급자의 well-known 문서에서 인증, 토큰, JWKS 엔드포인트를 자동으로 채우려면 디스커버리를 활성화하세요."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ative a descoberta para preencher automaticamente os endpoints de autorização, token e JWKS a partir do documento well-known do emissor."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Включите discovery, чтобы автоматически заполнять endpoints авторизации, токена и JWKS из well-known документа."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yetkilendirme, token ve JWKS uç noktalarını yayımlayıcının well-known belgesinden otomatik doldurmak için discovery'yi etkinleştirin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "启用发现以从颁发者的 well-known 文档自动填充授权、令牌和 JWKS 端点。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "啟用探索以從發行者的 well-known 文件自動填入授權、權杖和 JWKS 端點。"
          }
        }
      }
    },
