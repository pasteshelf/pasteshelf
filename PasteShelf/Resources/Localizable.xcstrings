          "stringUnit" : {
            "state" : "translated",
            "value" : "PKCE se recomienda para clientes de escritorio y no requiere un secreto de cliente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PKCE est recommandé pour les clients de bureau et ne nécessite pas de secret client."
          }
