    "Higher values require more accurate text recognition. Lower values may include misread text." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Höhere Werte erfordern eine genauere Texterkennung. Niedrigere Werte können falsch gelesenen Text enthalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los valores más altos requieren un reconocimiento de texto más preciso. Los valores más bajos pueden incluir texto mal leído."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les valeurs plus élevées exigent une reconnaissance de texte plus précise. Les valeurs plus basses peuvent inclure du texte mal lu."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "値が高いほど、より正確なテキスト認識が必要です。値が低いと誤読されたテキストが含まれる場合があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "값이 높을수록 정확한 텍스트 인식이 필요합니다. 값이 낮을수록 잘못 인식된 텍스트가 포함될 수 있습니다."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valores mais altos exigem reconhecimento de texto mais preciso. Valores mais baixos podem incluir texto mal lido."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Более высокие значения требуют точного распознавания текста. Более низкие могут включать ошибки."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daha yüksek değerler daha doğru metin tanıma gerektirir. Daha düşük değerler yanlış okunan metni içerebilir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "较高的值需要更准确的文本识别。较低的值可能包含误读的文本。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "較高的值需要更精確的文字辨識。較低的值可能包含誤讀的文字。"
          }
        }
      }
    },
    "Higher values show only more relevant matches. Lower values show more results." : {
      "comment" : "A description of the effect of changing the similarity threshold in semantic search.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Höhere Werte zeigen nur relevantere Treffer. Niedrigere Werte zeigen mehr Ergebnisse."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los valores más altos muestran solo coincidencias más relevantes. Los valores más bajos muestran más resultados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les valeurs plus élevées n'affichent que les correspondances les plus pertinentes. Les valeurs plus basses affichent plus de résultats."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "値が高いほど関連性の高い一致のみを表示します。値が低いほど多くの結果が表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "값이 높을수록 관련성 높은 일치 항목만 표시합니다. 값이 낮을수록 결과가 더 많이 표시됩니다."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valores mais altos mostram apenas correspondências mais relevantes. Valores mais baixos mostram mais resultados."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Более высокие значения показывают только более релевантные совпадения. Более низкие — больше результатов."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daha yüksek değerler yalnızca daha ilgili eşleşmeleri gösterir. Daha düşük değerler daha fazla sonuç gösterir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
