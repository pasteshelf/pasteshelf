    "Sync is disabled by default. Your clipboard history is stored locally on this device only." : {
      "comment" : "A description of how the default state of the sync feature works.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sync ist standardmäßig deaktiviert. Ihr Zwischenablage-Verlauf wird nur lokal gespeichert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sincronización está desactivada por defecto. Su historial se almacena localmente en este dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La synchronisation est désactivée par défaut. Votre historique est stocké localement sur cet appareil."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同期はデフォルトで無効です。クリップボード履歴はこの端末にのみ保存されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "동기화는 기본적으로 비활성화됩니다. 클립보드 기록은 이 기기에만 로컬로 저장됩니다."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A sincronização está desativada por padrão. Seu histórico é armazenado apenas neste dispositivo."
