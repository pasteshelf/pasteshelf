    "Fuzzy matching finds approximate matches even with typos or partial words." : {
      "comment" : "A description of the fuzzy matching feature, explaining its functionality.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unscharfe Suche findet ungefähre Übereinstimmungen auch bei Tippfehlern oder Wortteilen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La búsqueda difusa encuentra coincidencias aproximadas incluso con erratas o palabras parciales."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La recherche floue trouve des correspondances approximatives même avec des fautes de frappe ou des mots partiels."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あいまい一致は、誤字や部分的な単語でもおおよその一致を見つけます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "퍼지 매칭은 오타나 부분 단어로도 근사 일치를 찾습니다."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A correspondência aproximada encontra coincidências mesmo com erros de digitação ou palavras parciais."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нечёткий поиск находит совпадения даже с опечатками или частичными словами."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bulanık eşleştirme, yazım hataları veya kısmi sözcüklerde bile yaklaşık eşleşmeler bulur."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "即使存在拼写错误或部分单词，模糊匹配也能找到近似匹配。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "即使存在拼字錯誤或部分字詞，模糊比對仍能找到近似相符項目。"
          }
        }
      }
    },
