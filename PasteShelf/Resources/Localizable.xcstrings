    "Deletes all remote sync data and re-uploads your local clipboard history. Your local data is not affected." : {
      "comment" : "A description of the \"Reset Sync\" button.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Löscht alle Remote-Sync-Daten und lädt Ihren lokalen Verlauf erneut hoch. Ihre lokalen Daten bleiben unberührt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina todos los datos remotos y vuelve a subir su historial local. Sus datos locales no se verán afectados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supprime toutes les données distantes et réenvoie votre historique local. Vos données locales ne sont pas affectées."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべてのリモート同期データを削除し、ローカル履歴を再アップロードします。ローカルデータには影響しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 원격 동기화 데이터를 삭제하고 로컬 기록을 다시 업로드합니다. 로컬 데이터는 영향을 받지 않습니다."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exclui todos os dados remotos e reenvia seu histórico local. Seus dados locais não são afetados."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удаляет все удалённые данные синхронизации и перезагружает локальную историю. Локальные данные не затрагиваются."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tüm uzak senkronizasyon verilerini siler ve yerel geçmişinizi yeniden yükler. Yerel veriler etkilenmez."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "删除所有远程同步数据并重新上传您的本地剪贴板历史。本地数据不受影响。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "刪除所有遠端同步資料並重新上傳您的本機剪貼簿歷史記錄。本機資料不受影響。"
          }
        }
      }
    },
