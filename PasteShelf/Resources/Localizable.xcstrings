          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Собственная синхронизация подключается к частному серверу вашей организации для суверенитета данных."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
