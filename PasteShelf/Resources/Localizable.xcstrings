    "Paste the IdP metadata URL below and click Fetch to auto-populate the SAML configuration." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fügen Sie die IdP-Metadaten-URL unten ein und klicken Sie auf „Abrufen“, um die SAML-Konfiguration automatisch auszufüllen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pegue la URL de metadatos del IdP a continuación y haga clic en Obtener para rellenar automáticamente la configuración SAML."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Collez l'URL de métadonnées IdP ci-dessous et cliquez sur Récupérer pour remplir automatiquement la configuration SAML."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以下に IdP メタデータ URL をペーストし、「取得」をクリックして SAML 構成を自動入力します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아래에 IdP 메타데이터 URL을 붙여넣고 가져오기를 클릭하여 SAML 구성을 자동으로 채우세요."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cole a URL de metadados do IdP abaixo e clique em Buscar para preencher automaticamente a configuração SAML."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вставьте URL метаданных IdP ниже и нажмите «Получить», чтобы автоматически заполнить настройки SAML."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "IdP meta veri URL'sini aşağıya yapıştırın ve SAML yapılandırmasını otomatik doldurmak için Getir'e tıklayın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
