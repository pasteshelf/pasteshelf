    "Events older than the retention window are automatically deleted during the next scheduled pruning pass." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ereignisse, die älter als der Aufbewahrungszeitraum sind, werden beim nächsten geplanten Bereinigungslauf automatisch gelöscht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los eventos más antiguos que la ventana de retención se eliminan automáticamente durante la próxima pasada de limpieza programada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les événements plus anciens que la fenêtre de rétention sont automatiquement supprimés lors du prochain passage de purge planifié."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保持ウィンドウより古いイベントは、次回の定期削除パスで自動的に削除されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "보존 기간보다 오래된 이벤트는 다음 예정된 정리 과정에서 자동으로 삭제됩니다."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eventos mais antigos que a janela de retenção são excluídos automaticamente na próxima varredura agendada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "События, старше срока хранения, удаляются автоматически при следующей плановой чистке."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saklama penceresinden eski olaylar, planlanmış bir sonraki temizleme sırasında otomatik olarak silinir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "早于保留窗口的事件将在下次计划的清理过程中自动删除。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "早於保留期限的事件將在下次排程的清理過程中自動刪除。"
          }
        }
      }
    },
