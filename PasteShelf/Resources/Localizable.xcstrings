    "This may indicate a replay attack or misconfiguration. Contact your administrator." : {
      "comment" : "Recovery suggestion for when the destination URL in the SAML response does not match the expected value.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dies kann auf einen Replay-Angriff oder eine Fehlkonfiguration hinweisen. Wenden Sie sich an Ihren Administrator."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto puede indicar un ataque de repetición o una configuración incorrecta. Póngase en contacto con su administrador."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela peut indiquer une attaque par rejeu ou une mauvaise configuration. Contactez votre administrateur."
