    "Ensure the PasteShelf app is up to date and that the admin console server is running a compatible version." : {
      "comment" : "Recovery suggestion for when an invalid response is received from the admin console server.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
