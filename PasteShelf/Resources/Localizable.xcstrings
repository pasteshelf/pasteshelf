          }
        }
      }
    },
    "Paste the PEM-encoded X.509 certificate used to verify IdP-signed assertions." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fügen Sie das PEM-kodierte X.509-Zertifikat ein, das zur Überprüfung signierter IdP-Assertionen verwendet wird."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
