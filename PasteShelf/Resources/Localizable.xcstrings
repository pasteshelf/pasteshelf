    "iCloud access is restricted. Please check your account settings." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud-Zugriff ist eingeschränkt. Bitte überprüfen Sie Ihre Kontoeinstellungen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El acceso a iCloud está restringido. Revise los ajustes de su cuenta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'accès à iCloud est restreint. Veuillez vérifier vos réglages de compte."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud アクセスが制限されています。アカウント設定を確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud 접근이 제한되었습니다. 계정 설정을 확인하세요."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O acesso ao iCloud está restrito. Verifique as configurações da sua conta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Доступ к iCloud ограничен. Проверьте настройки аккаунта."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud erişimi kısıtlı. Hesap ayarlarınızı kontrol edin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud 访问受限。请检查您的账户设置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud 存取受限。請檢查您的帳號設定。"
          }
        }
      }
    },
    "iCloud is temporarily unavailable. Please try again later." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud ist vorübergehend nicht verfügbar. Bitte versuchen Sie es später erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud no está disponible temporalmente. Inténtelo de nuevo más tarde."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud est temporairement indisponible. Veuillez réessayer plus tard."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud は一時的に利用できません。後ほど再試行してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud을 일시적으로 사용할 수 없습니다. 나중에 다시 시도하세요."
          }
        },
        "pt" : {
          "stringUnit" : {
