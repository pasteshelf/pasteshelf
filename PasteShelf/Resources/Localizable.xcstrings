        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando está activado, los chips de filtro de etiquetas se muestran debajo de los filtros de tipo de contenido"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lorsque activé, les puces de filtre d'étiquettes s'affichent sous les filtres de type de contenu"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有効にすると、コンテンツタイプフィルタの下にタグフィルタが表示されます"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "활성화하면 콘텐츠 유형 필터 아래에 태그 필터 칩이 표시됩니다"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando ativado, os chips de filtro de etiquetas são mostrados abaixo dos filtros de tipo de conteúdo"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
