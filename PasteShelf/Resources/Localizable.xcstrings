    "Contact your IT administrator if the error persists, or check the admin console server status." : {
      "comment" : "Recovery suggestion for when an invalid response is received from the admin console server.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenden Sie sich an Ihren IT-Administrator, falls der Fehler weiterhin besteht, oder prüfen Sie den Status des Administrationskonsolen-Servers."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contacta con tu administrador de TI si el error persiste, o comprueba el estado del servidor de la consola de administración."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contactez votre administrateur informatique si l'erreur persiste, ou vérifiez l'état du serveur de la console d'administration."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "エラーが続く場合は IT 管理者にお問い合わせいただくか、管理コンソールサーバーの状態を確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "오류가 지속되면 IT 관리자에게 문의하거나 관리 콘솔 서버 상태를 확인하세요."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entre em contato com o administrador de TI se o erro persistir ou verifique o status do servidor do console de administração."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если ошибка сохраняется, обратитесь к ИТ-администратору или проверьте состояние сервера консоли администратора."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hata devam ederse BT yöneticinize başvurun veya yönetici konsolu sunucusunun durumunu kontrol edin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果错误仍然存在，请联系您的 IT 管理员，或检查管理控制台服务器状态。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
