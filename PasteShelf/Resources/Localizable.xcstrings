          }
        }
      }
    },
    "When enabled, the client verifies the server's TLS certificate against pinned certificates." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn aktiviert, verifiziert der Client das TLS-Zertifikat des Servers anhand gepinnter Zertifikate."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando está activado, el cliente verifica el certificado TLS del servidor contra certificados fijados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lorsque activé, le client vérifie le certificat TLS du serveur par rapport aux certificats épinglés."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有効にすると、クライアントはピニングされた証明書に対してサーバーの TLS 証明書を検証します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "활성화하면 클라이언트가 서버의 TLS 인증서를 고정된 인증서와 대조합니다."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando ativado, o cliente verifica o certificado TLS do servidor contra certificados fixados."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если включено, клиент проверяет TLS-сертификат сервера по закреплённым."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etkinleştirildiğinde istemci, sunucunun TLS sertifikasını sabitlenmiş sertifikalara göre doğrular."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "启用后，客户端将根据固定的证书验证服务器的 TLS 证书。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "啟用後，用戶端會根據釘選的憑證驗證伺服器的 TLS 憑證。"
          }
        }
      }
    },
