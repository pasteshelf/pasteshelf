    "Restart the application. If the problem continues, check available disk space or re-enroll the device." : {
      "comment" : "Recovery suggestion for a `DLPError.storageFailure` error.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starten Sie die App neu. Falls das Problem weiterhin besteht, prüfen Sie den verfügbaren Speicherplatz oder melden Sie das Gerät erneut an."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reinicia la aplicación. Si el problema persiste, comprueba el espacio en disco disponible o vuelve a inscribir el dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Redémarrez l'application. Si le problème persiste, vérifiez l'espace disque disponible ou réinscrivez l'appareil."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリケーションを再起動してください。問題が続く場合は、使用可能なディスク容量を確認するか、デバイスを再登録してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "응용 프로그램을 다시 시작하세요. 문제가 계속되면 사용 가능한 디스크 공간을 확인하거나 기기를 다시 등록하세요."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reinicie o aplicativo. Se o problema persistir, verifique o espaço em disco disponível ou reinscreva o dispositivo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перезапустите приложение. Если проблема сохраняется, проверьте свободное место на диске или повторно зарегистрируйте устройство."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uygulamayı yeniden başlatın. Sorun devam ederse kullanılabilir disk alanını kontrol edin veya cihazı yeniden kaydedin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请重启应用。如果问题仍然存在，请检查可用磁盘空间或重新注册设备。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請重新啟動應用程式。若問題仍然存在,請檢查可用磁碟空間或重新註冊裝置。"
          }
        }
      }
    },
