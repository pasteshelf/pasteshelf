          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etkinleştirildiğinde, etiket filtre çipleri içerik türü filtrelerinin altında gösterilir"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
