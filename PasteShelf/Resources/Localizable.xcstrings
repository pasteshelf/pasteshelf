          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "セルフホスト同期は、データ主権のために組織のプライベート同期サーバーに接続します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "자체 호스팅 동기화는 데이터 주권을 위해 조직의 비공개 동기화 서버에 연결됩니다."
          }
        },
        "pt" : {
          "stringUnit" : {
