          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "IdP 서명 어설션을 검증하는 데 사용되는 PEM 인코딩된 X.509 인증서를 붙여넣으세요."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cole o certificado X.509 codificado em PEM usado para verificar as asserções assinadas pelo IdP."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вставьте PEM-кодированный X.509 сертификат, используемый для проверки подписи IdP."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "IdP imzalı assertion'ları doğrulamak için kullanılan PEM kodlu X.509 sertifikasını yapıştırın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
