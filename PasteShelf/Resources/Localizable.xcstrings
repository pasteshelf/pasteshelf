          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sincronización autohospedada se conecta al servidor privado de su organización para la soberanía de datos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
