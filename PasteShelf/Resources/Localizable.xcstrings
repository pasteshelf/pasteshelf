      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn aktiviert, werden Tag-Filter-Chips unter den Inhaltstypfiltern angezeigt"
