# PasteShelf Sync Server Configuration
# Copy this file to .env and replace ALL placeholder values before running.

# PostgreSQL
POSTGRES_USER=pasteshelf
POSTGRES_PASSWORD=REPLACE_WITH_SECURE_PASSWORD
POSTGRES_DB=pasteshelf_sync

# JWT Secret (generate with: openssl rand -hex 32)
JWT_SECRET=REPLACE_WITH_GENERATED_SECRET

# Organization ID for multi-tenant deployments
ORG_ID=default
