#!/bin/bash
# Pre-commit hook for SwiftLint and SwiftFormat validation
# This script runs linting and formatting checks before each commit.
# If any check fails, the commit is aborted.

set -e

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

echo "🔍 Running pre-commit checks..."

# Get the root directory of the git repository
ROOT_DIR=$(git rev-parse --show-toplevel)
cd "$ROOT_DIR"

# Check if SwiftFormat is installed
if command -v swiftformat &> /dev/null; then
    echo "📐 Running SwiftFormat lint..."
    if ! swiftformat --lint . 2>/dev/null; then
        echo -e "${RED}❌ SwiftFormat found formatting issues.${NC}"
        echo -e "${YELLOW}Run 'swiftformat .' to fix formatting issues.${NC}"
        exit 1
    fi
    echo -e "${GREEN}✓ SwiftFormat check passed${NC}"
else
    echo -e "${YELLOW}⚠️  SwiftFormat not installed, skipping format check.${NC}"
fi

# Check if SwiftLint is installed
if command -v swiftlint &> /dev/null; then
    echo "🔍 Running SwiftLint..."
    if ! swiftlint lint --strict --quiet 2>/dev/null; then
        echo -e "${RED}❌ SwiftLint found issues.${NC}"
        echo -e "${YELLOW}Run 'swiftlint' to see detailed lint warnings.${NC}"
        exit 1
    fi
    echo -e "${GREEN}✓ SwiftLint check passed${NC}"
else
    echo -e "${YELLOW}⚠️  SwiftLint not installed, skipping lint check.${NC}"
fi

echo -e "${GREEN}✅ All pre-commit checks passed!${NC}"
exit 0
